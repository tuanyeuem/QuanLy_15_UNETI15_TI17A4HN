@* Họ và tên: Vũ Xuân Tuấn — Mã SV: 23103100035 — Danh sách đặt phòng, tìm kiếm, lọc dữ liệu nền, sắp xếp, phân trang *@
@model QuanLy_15_UNETI15_TI17A4HN.ViewModels.DatPhongListViewModel
@{ ViewData["Title"] = "Quản lý đặt phòng"; }

<h2 class="mb-3">Quản lý đặt phòng</h2>

@if (TempData["ThanhCong"] != null) { <div class="alert alert-success">@TempData["ThanhCong"]</div> }
@if (TempData["Loi"] != null)       { <div class="alert alert-danger">@TempData["Loi"]</div>       }

<!-- Form tìm kiếm, lọc từng điều kiện hoặc kết hợp (Mục 8.1 & 22.3) -->
<form method="get" asp-action="Index" class="card card-body bg-light mb-4 shadow-sm">
    <div class="row g-2">
        <!-- 1. Tìm theo khách hàng hoặc phòng -->
        <div class="col-md-3">
            <label class="form-label small fw-bold">Tìm kiếm:</label>
            <input name="TimKiem" value="@Model.TimKiem" class="form-control form-control-sm" placeholder="🔍 Tên khách / Số phòng" />
        </div>

        <!-- 2. Lọc theo dữ liệu nền (Loại phòng) -->
        <div class="col-md-2">
            <label class="form-label small fw-bold">Loại phòng :</label>
            <select name="MaLoaiPhong" class="form-select form-select-sm">
                <option value="">-- Tất cả loại phòng --</option>
                @foreach (var lp in Model.DanhSachLoaiPhong)
                {
                    <option value="@lp.MaLoaiPhong" selected="@(Model.MaLoaiPhong == lp.MaLoaiPhong ? "selected" : null)">@lp.TenLoai</option>
                }
            </select>
        </div>

        <!-- 3. Lọc theo trạng thái -->
        <div class="col-md-2">
            <label class="form-label small fw-bold">Trạng thái:</label>
            <select name="LocTrangThai" class="form-select form-select-sm">
                <option value="">-- Tất cả trạng thái --</option>
                @foreach (var tt in Model.DanhSachTrangThai)
                {
                    <option value="@tt" selected="@(Model.LocTrangThai == tt ? "selected" : null)">@tt</option>
                }
            </select>
        </div>

        <!-- 4. Lọc theo khoảng ngày nhận -->
        <div class="col-md-3">
            <label class="form-label small fw-bold">Khoảng ngày nhận:</label>
            <div class="input-group input-group-sm">
                <input type="date" name="TuNgay" value="@Model.TuNgay?.ToString("yyyy-MM-dd")" class="form-control" title="Từ ngày nhận" />
                <span class="input-group-text">→</span>
                <input type="date" name="DenNgay" value="@Model.DenNgay?.ToString("yyyy-MM-dd")" class="form-control" title="Đến ngày nhận" />
            </div>
        </div>

        <!-- 5. Sắp xếp tăng / giảm theo ngày hoặc theo tên -->
        <div class="col-md-2">
            <label class="form-label small fw-bold">Sắp xếp:</label>
            <select name="SapXep" class="form-select form-select-sm">
                <option value="ngaydat_moi"  selected="@(Model.SapXep == "ngaydat_moi"  ? "selected" : null)">Ngày đặt ↓ (Mới nhất)</option>
                <option value="ngaydat_cu"   selected="@(Model.SapXep == "ngaydat_cu"   ? "selected" : null)">Ngày đặt ↑ (Cũ nhất)</option>
                <option value="ngaynhan_moi" selected="@(Model.SapXep == "ngaynhan_moi" ? "selected" : null)">Ngày nhận ↓ (Mới nhất)</option>
                <option value="ngaynhan_cu"  selected="@(Model.SapXep == "ngaynhan_cu"  ? "selected" : null)">Ngày nhận ↑ (Cũ nhất)</option>
                <option value="tenkhach_asc" selected="@(Model.SapXep == "tenkhach_asc" ? "selected" : null)">Tên khách A → Z</option>
                <option value="tenkhach_desc" selected="@(Model.SapXep == "tenkhach_desc"? "selected" : null)">Tên khách Z → A</option>
            </select>
        </div>

        <div class="col-12 text-end mt-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-2">Đặt lại</a>
            <button type="submit" class="btn btn-sm btn-primary px-3">🔍 Lọc dữ liệu</button>
        </div>
    </div>
</form>

<!-- Bảng kết quả -->
<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Mã ĐP</th>
                <th>Khách hàng</th>
                <th>Phòng</th>
                <th>Loại phòng</th>
                <th>Ngày đặt</th>
                <th>Ngày nhận</th>
                <th>Ngày trả DK</th>
                <th>Số người</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var dp in Model.DanhSach)
            {
                var badge = dp.TrangThai switch {
                    "ChoDuyet"    => "bg-warning text-dark",
                    "DaDuyet"     => "bg-info text-dark",
                    "DaNhanPhong" => "bg-primary",
                    "DaTraPhong"  => "bg-success",
                    "Huy"         => "bg-danger",
                    _             => "bg-secondary"
                };
                <tr>
                    <td><strong>#@dp.MaDatPhong</strong></td>
                    <td>@dp.KhachHang.HoTen</td>
                    <td><strong>@dp.Phong.SoPhong</strong></td>
                    <td>@dp.Phong.LoaiPhong.TenLoai</td>
                    <td>@dp.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@dp.NgayNhan.ToString("dd/MM/yyyy")</td>
                    <td>@dp.NgayTraDuKien.ToString("dd/MM/yyyy")</td>
                    <td>@dp.SoNguoi</td>
                    <td><span class="badge @badge">@dp.TrangThai</span></td>
                    <td>
                        <a asp-action="ChiTiet" asp-route-id="@dp.MaDatPhong" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                    </td>
                </tr>
            }
            @if (!Model.DanhSach.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">
                        <em>Không tìm thấy kết quả nào phù hợp với điều kiện tìm kiếm/lọc.</em>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Phân trang: Trang đầu / trước / giữa / sau / cuối & giữ nguyên toàn bộ điều kiện (Mục 22.3) -->
@if (Model.TongSoTrang > 1)
{
    <nav class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted small">
            Trang <strong>@Model.TrangHienTai</strong> / <strong>@Model.TongSoTrang</strong>
        </span>
        <ul class="pagination pagination-sm mb-0">
            <!-- Nút Trang đầu -->
            <li class="page-item @(Model.TrangHienTai <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-TrangHienTai="1"
                   asp-route-TimKiem="@Model.TimKiem"
                   asp-route-MaLoaiPhong="@Model.MaLoaiPhong"
                   asp-route-LocTrangThai="@Model.LocTrangThai"
                   asp-route-TuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                   asp-route-DenNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")"
                   asp-route-SapXep="@Model.SapXep">« Đầu</a>
            </li>

            <!-- Nút Trước -->
            <li class="page-item @(Model.TrangHienTai <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-TrangHienTai="@(Model.TrangHienTai - 1)"
                   asp-route-TimKiem="@Model.TimKiem"
                   asp-route-MaLoaiPhong="@Model.MaLoaiPhong"
                   asp-route-LocTrangThai="@Model.LocTrangThai"
                   asp-route-TuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                   asp-route-DenNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")"
                   asp-route-SapXep="@Model.SapXep">‹ Trước</a>
            </li>

            <!-- Các trang ở giữa -->
            @for (int i = Math.Max(1, Model.TrangHienTai - 2); i <= Math.Min(Model.TongSoTrang, Model.TrangHienTai + 2); i++)
            {
                <li class="page-item @(i == Model.TrangHienTai ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-TrangHienTai="@i"
                       asp-route-TimKiem="@Model.TimKiem"
                       asp-route-MaLoaiPhong="@Model.MaLoaiPhong"
                       asp-route-LocTrangThai="@Model.LocTrangThai"
                       asp-route-TuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                       asp-route-DenNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")"
                       asp-route-SapXep="@Model.SapXep">@i</a>
                </li>
            }

            <!-- Nút Sau -->
            <li class="page-item @(Model.TrangHienTai >= Model.TongSoTrang ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-TrangHienTai="@(Model.TrangHienTai + 1)"
                   asp-route-TimKiem="@Model.TimKiem"
                   asp-route-MaLoaiPhong="@Model.MaLoaiPhong"
                   asp-route-LocTrangThai="@Model.LocTrangThai"
                   asp-route-TuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                   asp-route-DenNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")"
                   asp-route-SapXep="@Model.SapXep">Sau ›</a>
            </li>

            <!-- Nút Trang cuối -->
            <li class="page-item @(Model.TrangHienTai >= Model.TongSoTrang ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-TrangHienTai="@Model.TongSoTrang"
                   asp-route-TimKiem="@Model.TimKiem"
                   asp-route-MaLoaiPhong="@Model.MaLoaiPhong"
                   asp-route-LocTrangThai="@Model.LocTrangThai"
                   asp-route-TuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                   asp-route-DenNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")"
                   asp-route-SapXep="@Model.SapXep">Cuối »</a>
            </li>
        </ul>
    </nav>
}
