@* Họ và tên: Nguyễn Đình Quang
   Mã sinh viên: 23103100259
   Nội dung thực hiện: Module 3 - Form tạo đặt phòng. *@
@model QuanLy_15_UNETI15_TI17A4HN.ViewModels.TaoDatPhongViewModel
@{ ViewData["Title"] = "Đặt phòng"; }

<h2>Tạo đặt phòng</h2>
<p class="text-muted">Phòng được kiểm tra lịch trống và sức chứa khi gửi yêu cầu. Ngày đặt và trạng thái do hệ thống ghi nhận.</p>
<form asp-action="DatPhong" method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6"><label asp-for="NgayNhan" class="form-label"></label><input asp-for="NgayNhan" type="date" class="form-control" /><span asp-validation-for="NgayNhan" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="NgayTraDuKien" class="form-label"></label><input asp-for="NgayTraDuKien" type="date" class="form-control" /><span asp-validation-for="NgayTraDuKien" class="text-danger"></span></div>
    <div class="col-md-8"><label asp-for="MaPhong" class="form-label"></label><select asp-for="MaPhong" asp-items="Model.DanhSachPhong" class="form-select"><option value="">-- Chọn phòng còn khả dụng --</option></select><span asp-validation-for="MaPhong" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="SoNguoi" class="form-label"></label><input asp-for="SoNguoi" class="form-control" /><span asp-validation-for="SoNguoi" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="TienCoc" class="form-label"></label><input asp-for="TienCoc" class="form-control" min="0" step="1000" /><span asp-validation-for="TienCoc" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="GhiChu" class="form-label"></label><textarea asp-for="GhiChu" class="form-control" rows="3"></textarea><span asp-validation-for="GhiChu" class="text-danger"></span></div>
    <div class="col-12"><button type="submit" class="btn btn-primary">Gửi yêu cầu đặt phòng</button> <a asp-action="TheoDoi" class="btn btn-outline-secondary">Theo dõi đặt phòng</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
