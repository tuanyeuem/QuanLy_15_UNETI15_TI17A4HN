@* Họ và tên: Nguyễn Đình Quang
   Mã sinh viên: 23103100259
   Nội dung thực hiện: Module 3 - Form thêm và cập nhật khách hàng. *@
@model QuanLy_15_UNETI15_TI17A4HN.ViewModels.KhachHangQuanLyViewModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input asp-for="MaKhachHang" type="hidden" />
<div class="row g-3">
    <div class="col-md-6"><label asp-for="HoTen" class="form-label"></label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="NgaySinh" class="form-label"></label><input asp-for="NgaySinh" type="date" class="form-control" /><span asp-validation-for="NgaySinh" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="GioiTinh" class="form-label"></label><select asp-for="GioiTinh" class="form-select"><option value="">-- Chọn --</option><option>Nam</option><option>Nữ</option><option>Khác</option></select></div>
    <div class="col-md-6"><label asp-for="CCCD" class="form-label"></label><input asp-for="CCCD" class="form-control" /><span asp-validation-for="CCCD" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="SoDienThoai" class="form-label"></label><input asp-for="SoDienThoai" class="form-control" /><span asp-validation-for="SoDienThoai" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="DiaChi" class="form-label"></label><input asp-for="DiaChi" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="QuocTich" class="form-label"></label><input asp-for="QuocTich" class="form-control" /></div>
    <div class="col-12"><label asp-for="GhiChu" class="form-label"></label><textarea asp-for="GhiChu" class="form-control" rows="3"></textarea></div>
    @if (Model.MaKhachHang > 0) { <div class="col-12 form-check ms-2"><input asp-for="TrangThai" class="form-check-input" /><label asp-for="TrangThai" class="form-check-label"></label></div> }
</div>
