@* Họ và tên: Lê Văn Thanh *@
@* Mã sinh viên: 23103100200 *@
@* Nội dung thực hiện: Module 5 - Xem chi tiết một phòng trong lần đặt. *@
@using QuanLy_15_UNETI15_TI17A4HN.Helpers
@model ChiTietDatPhong
@{
    ViewData["Title"] = "Chi tiết #" + Model.MaChiTiet;
    var vaiTro = Context.Session.GetString("VaiTro");
    var laNhanSu = vaiTro == VaiTroTaiKhoan.Admin || vaiTro == VaiTroTaiKhoan.NhanVien;
}

<h2 class="mb-3">Chi tiết đặt phòng #@Model.MaChiTiet</h2>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Khách hàng</dt>
            <dd class="col-sm-9">@Model.DatPhong.KhachHang.HoTen</dd>

            <dt class="col-sm-3">Lần đặt phòng</dt>
            <dd class="col-sm-9">
                #@Model.MaDatPhong
                <span class="badge @TrangThaiUi.Badge(Model.DatPhong.TrangThai)">@Model.DatPhong.TrangThai</span>
            </dd>

            <dt class="col-sm-3">Phòng</dt>
            <dd class="col-sm-9">@Model.Phong.SoPhong - @Model.Phong.LoaiPhong.TenLoai (tầng @Model.Phong.Tang)</dd>

            <dt class="col-sm-3">Ngày nhận</dt>
            <dd class="col-sm-9">@Model.NgayNhan.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Ngày trả</dt>
            <dd class="col-sm-9">@Model.NgayTra.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Đơn giá</dt>
            <dd class="col-sm-9">@TrangThaiUi.Tien(Model.DonGia) / ngày</dd>

            <dt class="col-sm-3">Số ngày</dt>
            <dd class="col-sm-9">@Model.SoNgay</dd>

            <dt class="col-sm-3">Thành tiền</dt>
            <dd class="col-sm-9 fw-semibold">
                @TrangThaiUi.Tien(Model.ThanhTien)
                @if (Model.TrangThai != TrangThaiChiTiet.DaTra && Model.TrangThai != TrangThaiChiTiet.DaHuy)
                {
                    <small class="text-muted">(tạm tính)</small>
                }
            </dd>

            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9"><span class="badge @TrangThaiUi.Badge(Model.TrangThai)">@Model.TrangThai</span></dd>

            <dt class="col-sm-3">Cập nhật lúc</dt>
            <dd class="col-sm-9">@(Model.NgayCapNhat?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="KetQua" asp-route-maDatPhong="@Model.MaDatPhong" class="btn btn-outline-primary">Xem kết quả lần đặt</a>
    @if (laNhanSu)
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Về danh sách</a>
    }
    else
    {
        <a asp-action="KetQuaCuaToi" class="btn btn-outline-secondary">Về danh sách của tôi</a>
    }
</div>
