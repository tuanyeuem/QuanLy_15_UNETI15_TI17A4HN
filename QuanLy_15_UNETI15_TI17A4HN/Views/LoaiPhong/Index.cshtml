@* Họ tên: Nguyễn Đình Tuấn | MSSV: 23103100235 | Nội dung: Quản lý loại phòng. *@
@model IEnumerable<QuanLy_15_UNETI15_TI17A4HN.Models.LoaiPhong>
@{ViewData["Title"]="Quản lý loại phòng";}
<div class="d-flex justify-content-between mb-3"><h1>Quản lý loại phòng</h1><a asp-action="Create" class="btn btn-primary">Thêm loại phòng</a></div>
@if(TempData["ThongBao"] is string ok){<div class="alert alert-success">@ok</div>} @if(TempData["Loi"] is string err){<div class="alert alert-danger">@err</div>}
<form method="get" class="row g-2 mb-3"><div class="col-md-6"><input name="tuKhoa" value="@ViewData["TuKhoa"]" class="form-control" placeholder="Tìm loại phòng"/></div><div class="col-md-3"><select name="trangThai" class="form-select"><option value="">Mọi trạng thái</option><option value="hoatdong" selected="@(ViewData["TrangThai"] as string=="hoatdong")">Đang kinh doanh</option><option value="ngung" selected="@(ViewData["TrangThai"] as string=="ngung")">Ngừng kinh doanh</option></select></div><div class="col-md-3"><button class="btn btn-outline-primary">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Tên loại</th><th>Số người tối đa</th><th>Đơn giá/ngày</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.TenLoai</td><td>@x.SoNguoiToiDa</td><td>@x.DonGiaNgay.ToString("N0") đ</td><td>@(x.TrangThai?"Đang kinh doanh":"Ngừng kinh doanh")</td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@x.MaLoaiPhong" class="btn btn-sm btn-outline-info">Chi tiết</a> <a asp-action="Edit" asp-route-id="@x.MaLoaiPhong" class="btn btn-sm btn-outline-primary">Sửa</a> <form asp-action="DoiTrangThai" asp-route-id="@x.MaLoaiPhong" method="post" class="d-inline"><button class="btn btn-sm btn-outline-warning">@(x.TrangThai?"Ngừng bán":"Mở bán")</button></form> <a asp-action="Delete" asp-route-id="@x.MaLoaiPhong" class="btn btn-sm btn-outline-danger">Xóa</a></td></tr>}
</tbody></table></div>