@model QuanLy_15_UNETI15_TI17A4HN.Models.DatPhong
@{ ViewData["Title"] = "Hủy đặt phòng"; }
<h3>Hủy đặt phòng #@Model.MaDatPhong</h3>
<div class="alert alert-danger">⚠ Thao tác này không thể khôi phục!</div>
<form asp-action="Huy" method="post">
    <input type="hidden" name="id" value="@Model.MaDatPhong" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">Lý do hủy <span class="text-danger">*</span></label>
        <textarea name="lyDoHuy" class="form-control" rows="3" required placeholder="Nhập lý do hủy..."></textarea>
    </div>
    <button type="submit" class="btn btn-danger">✖ Xác nhận hủy</button>
    <a asp-action="ChiTiet" asp-route-id="@Model.MaDatPhong" class="btn btn-secondary ms-2">Quay lại</a>
</form>
