@* Họ và tên: Vũ Kiều Trinh
   Mã sinh viên: 23103100199
   Nội dung thực hiện: Module 2 - Sửa phòng và tải ảnh phòng. *@
@using QuanLy_15_UNETI15_TI17A4HN.Helpers
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@model QuanLy_15_UNETI15_TI17A4HN.Models.Phong

@{
    ViewData["Title"] = "Chỉnh sửa phòng";

    var dsLoai = ViewData["MaLoaiPhong"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var tenLoai = dsLoai?.FirstOrDefault(x => x.Value == Model.MaLoaiPhong.ToString())?.Text;
    var anhRieng = PhongAnhHelper.AnhRieng(Env, Model.MaPhong);
    var anhHienTai = anhRieng ?? PhongAnhHelper.AnhMacDinh(tenLoai, Model.MaLoaiPhong);
    var urlDoiAnh = Url.Action("Doi", "PhongAnh", new { id = Model.MaPhong });
    var urlXoaAnh = Url.Action("Xoa", "PhongAnh", new { id = Model.MaPhong });
}

<div class="container py-4">
    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Chỉnh sửa phòng</h2>
            <p class="text-muted mb-0">
                Cập nhật thông tin và trạng thái phòng khách sạn
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <partial name="_ThongBao" />

    <form asp-action="Edit" asp-route-id="@Model.MaPhong"
          method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="MaPhong" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="row g-4">
            <!-- Cột thông tin chính -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-door-open me-2 text-primary"></i>
                            Thông tin phòng
                        </h5>
                    </div>

                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="MaPhong"
                                       class="form-label"></label>
                                <input value="@Model.MaPhong"
                                       class="form-control bg-light"
                                       readonly />
                                <div class="form-text">
                                    Mã phòng không thể thay đổi.
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SoPhong"
                                       class="form-label"></label>
                                <input asp-for="SoPhong"
                                       class="form-control" />
                                <span asp-validation-for="SoPhong"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MaLoaiPhong"
                                       class="form-label"></label>
                                <select asp-for="MaLoaiPhong"
                                        asp-items="ViewBag.MaLoaiPhong"
                                        class="form-select">
                                    <option value="">
                                        -- Chọn loại phòng --
                                    </option>
                                </select>
                                <span asp-validation-for="MaLoaiPhong"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Tang"
                                       class="form-label"></label>
                                <input asp-for="Tang"
                                       type="number"
                                       min="1"
                                       max="100"
                                       class="form-control" />
                                <span asp-validation-for="Tang"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="HuongPhong"
                                       class="form-label"></label>
                                <input asp-for="HuongPhong"
                                       class="form-control"
                                       placeholder="VD: Hướng biển, hướng phố" />
                                <span asp-validation-for="HuongPhong"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DonGia"
                                       class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DonGia"
                                           type="number"
                                           min="0.01"
                                           step="0.01"
                                           class="form-control" />
                                    <span class="input-group-text">VNĐ</span>
                                </div>
                                <span asp-validation-for="DonGia"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="TienNghi"
                                       class="form-label"></label>
                                <textarea asp-for="TienNghi"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Nhập tiện nghi của phòng..."></textarea>
                                <span asp-validation-for="TienNghi"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="GhiChu"
                                       class="form-label"></label>
                                <textarea asp-for="GhiChu"
                                          class="form-control"
                                          rows="2"
                                          placeholder="Ghi chú thêm (nếu có)"></textarea>
                                <span asp-validation-for="GhiChu"
                                      class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bảo trì -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-tools me-2 text-warning"></i>
                            Thông tin bảo trì
                        </h5>
                    </div>

                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NgayBaoTri"
                                       class="form-label"></label>
                                <input asp-for="NgayBaoTri"
                                       type="date"
                                       class="form-control" />
                                <span asp-validation-for="NgayBaoTri"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="GhiChuBaoTri"
                                       class="form-label"></label>
                                <textarea asp-for="GhiChuBaoTri"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Mô tả tình trạng hoặc nội dung bảo trì..."></textarea>
                                <span asp-validation-for="GhiChuBaoTri"
                                      class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột trạng thái -->
            <div class="col-lg-4">
                <!-- Ảnh phòng -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-semibold">Ảnh phòng</h5>
                    </div>
                    <div class="card-body p-4">
                        <img id="xemTruocAnh" class="room-hero rounded-3 mb-3" src="@anhHienTai" alt="Ảnh phòng @Model.SoPhong" />
                        <div id="thongBaoAnh" class="small mb-2" role="status" aria-live="polite"></div>
                        <input id="tepAnhPhong" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
                        <div class="form-text">
                            JPG, PNG hoặc WEBP, tối đa 5 MB. Ảnh được lưu ngay khi bấm "Tải ảnh lên",
                            không cần bấm "Lưu thay đổi".
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button type="button" id="nutTaiAnh" class="btn btn-primary btn-sm" disabled>Tải ảnh lên</button>
                            <button type="button" id="nutXoaAnh" class="btn btn-outline-secondary btn-sm" hidden="@(anhRieng == null)">Dùng ảnh mặc định</button>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-gear me-2 text-primary"></i>
                            Trạng thái phòng
                        </h5>
                    </div>

                    <div class="card-body p-4">
                        <label asp-for="TrangThai"
                               class="form-label"></label>

                        <select asp-for="TrangThai"
                                class="form-select">
                            <option value="TrongRanh">Còn trống</option>
                            <option value="DaDat">Đã đặt</option>
                            <option value="DangSuDung">Đang sử dụng</option>
                            <option value="BaoTri">Bảo trì</option>
                            <option value="KhongKinhDoanh">Ngừng kinh doanh</option>
                        </select>

                        <span asp-validation-for="TrangThai"
                              class="text-danger small"></span>

                        <hr class="my-4" />

                        <div class="small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Kiểm tra kỹ thông tin trước khi lưu.
                            Mã phòng được giữ nguyên trong quá trình chỉnh sửa.
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <button type="submit"
                                class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-check-circle me-1"></i>
                            Lưu thay đổi
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary w-100">
                            Hủy
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            var tepAnh = document.getElementById('tepAnhPhong');
            var nutTai = document.getElementById('nutTaiAnh');
            var nutXoa = document.getElementById('nutXoaAnh');
            var anh = document.getElementById('xemTruocAnh');
            var thongBao = document.getElementById('thongBaoAnh');
            var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            var urlDoi = '@urlDoiAnh';
            var urlXoa = '@urlXoaAnh';
            var toiDa = 5 * 1024 * 1024;
            var duocPhep = ['image/jpeg', 'image/png', 'image/webp'];
            var anhDangLuu = anh.getAttribute('src');

            function bao(noiDung, loi) {
                thongBao.textContent = noiDung;
                thongBao.className = 'small mb-2 ' + (loi ? 'text-danger' : 'text-success');
            }

            function guiYeuCau(url, duLieu, khiXong) {
                nutTai.disabled = true;
                nutXoa.disabled = true;
                if (tokenEl) { duLieu.append('__RequestVerificationToken', tokenEl.value); }
                fetch(url, {
                    method: 'POST',
                    body: duLieu,
                    credentials: 'same-origin',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(function (kq) {
                        return kq.json().then(function (d) { return { ok: kq.ok, d: d }; });
                    })
                    .then(function (kq) {
                        bao(kq.d.message || 'Đã xử lý.', !kq.ok);
                        if (kq.ok) { khiXong(kq.d); }
                    })
                    .catch(function () { bao('Không gửi được yêu cầu. Vui lòng thử lại.', true); })
                    .then(function () {
                        nutXoa.disabled = false;
                        nutTai.disabled = !(tepAnh.files && tepAnh.files.length);
                    });
            }

            tepAnh.addEventListener('change', function () {
                var tep = tepAnh.files && tepAnh.files[0];
                nutTai.disabled = !tep;
                if (!tep) { anh.src = anhDangLuu; bao('', false); return; }
                if (duocPhep.indexOf(tep.type) < 0) { bao('Chỉ chấp nhận ảnh JPG, PNG hoặc WEBP.', true); nutTai.disabled = true; return; }
                if (tep.size > toiDa) { bao('Ảnh quá lớn. Dung lượng tối đa là 5 MB.', true); nutTai.disabled = true; return; }
                anh.src = URL.createObjectURL(tep);
                bao('Đây là bản xem trước. Bấm "Tải ảnh lên" để lưu.', false);
            });

            nutTai.addEventListener('click', function () {
                var tep = tepAnh.files && tepAnh.files[0];
                if (!tep) { return; }
                var duLieu = new FormData();
                duLieu.append('tepAnh', tep);
                guiYeuCau(urlDoi, duLieu, function (d) {
                    anhDangLuu = d.url;
                    anh.src = d.url;
                    tepAnh.value = '';
                    nutXoa.hidden = !d.coAnhRieng;
                });
            });

            nutXoa.addEventListener('click', function () {
                if (!confirm('Xóa ảnh riêng của phòng này và dùng lại ảnh mặc định?')) { return; }
                guiYeuCau(urlXoa, new FormData(), function (d) {
                    anhDangLuu = d.url;
                    anh.src = d.url;
                    tepAnh.value = '';
                    nutXoa.hidden = true;
                });
            });
        })();
    </script>
}
