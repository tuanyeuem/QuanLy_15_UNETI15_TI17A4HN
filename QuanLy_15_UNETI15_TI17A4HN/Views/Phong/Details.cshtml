@* Họ và tên: Vũ Kiều Trinh
   Mã sinh viên: 23103100199
   Nội dung thực hiện: Module 2 - Xem chi tiết phòng. *@
@using QuanLy_15_UNETI15_TI17A4HN.Helpers
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@model QuanLy_15_UNETI15_TI17A4HN.Models.Phong

@{
    ViewData["Title"] = "Chi tiết phòng";

    var vaiTro = Context.Session.GetString("VaiTro");
    bool laQuanLy = vaiTro == "Admin" || vaiTro == "NhanVien";
}

<div class="container py-4">
    <!-- Tiêu đề -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Chi tiết phòng</h2>
            <p class="text-muted mb-0">
                Thông tin đầy đủ về phòng khách sạn
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (laQuanLy)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.MaPhong"
                   class="btn btn-primary">
                    <i class="bi bi-pencil-square me-1"></i>
                    Chỉnh sửa
                </a>
            }

            <a asp-action="@(laQuanLy ? "Index" : "TimKiem")"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Quay lại
            </a>
        </div>
    </div>

    <!-- Ảnh phòng -->
    <div class="card border-0 shadow-sm mb-4 overflow-hidden">
        <img class="room-hero" src="@PhongAnhHelper.Url(Env, Model)" alt="Ảnh phòng @Model.SoPhong" />
    </div>

    <!-- Thông tin tổng quan -->
    <div class="card border-0 shadow-sm mb-4 overflow-hidden">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-md">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-primary bg-opacity-10
                            text-primary p-3">
                            <i class="bi bi-door-open fs-2"></i>
                        </div>

                        <div>
                            <div class="text-muted small">Mã phòng</div>
                            <h3 class="fw-bold mb-1">@Model.MaPhong</h3>
                            <div class="text-muted">
                                Phòng số @Model.SoPhong
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-auto">
                    <span class="tt @TrangThaiUi.LopPhong(Model.TrangThai)">@TrangThaiUi.NhanPhong(Model.TrangThai)</span>
                </div>

                <div class="col-md-auto">
                    <div class="text-muted small">Đơn giá phòng</div>
                    <div class="fs-4 fw-bold text-primary">
                        @Model.DonGia.ToString("N0")
                        <small class="fs-6">VNĐ</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Thông tin phòng -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-semibold mb-0">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        Thông tin phòng
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-sm-6">
                            <div class="text-muted small mb-1">Mã phòng</div>
                            <div class="fw-semibold">@Model.MaPhong</div>
                        </div>

                        <div class="col-sm-6">
                            <div class="text-muted small mb-1">Số phòng</div>
                            <div class="fw-semibold">@Model.SoPhong</div>
                        </div>

                        <div class="col-sm-6">
                            <div class="text-muted small mb-1">Mã loại phòng</div>
                            <div class="fw-semibold">
                                @Model.MaLoaiPhong
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="text-muted small mb-1">Tên loại phòng</div>
                            <div class="fw-semibold">
                                @(Model.LoaiPhong?.TenLoai ?? "Chưa có thông tin")
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="text-muted small mb-1">Tầng</div>
                            <div class="fw-semibold">Tầng @Model.Tang</div>
                        </div>

                        <div class="col-sm-6">
                            <div class="text-muted small mb-1">Hướng phòng</div>
                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.HuongPhong)
                                    ? "Chưa cập nhật"
                                    : Model.HuongPhong)
                            </div>
                        </div>

                        <div class="col-12">
                            <hr />
                            <div class="text-muted small mb-2">Tiện nghi</div>
                            <div class="p-3 bg-light rounded-3"
                                 style="white-space: pre-line">
                                @(string.IsNullOrWhiteSpace(Model.TienNghi)
                                    ? "Chưa cập nhật tiện nghi"
                                    : Model.TienNghi)
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="text-muted small mb-2">Ghi chú</div>
                            <div class="p-3 bg-light rounded-3"
                                 style="white-space: pre-line">
                                @(string.IsNullOrWhiteSpace(Model.GhiChu)
                                    ? "Không có ghi chú"
                                    : Model.GhiChu)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thông tin bảo trì -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-semibold mb-0">
                        <i class="bi bi-tools text-warning me-2"></i>
                        Thông tin bảo trì
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="mb-4">
                        <div class="text-muted small mb-1">
                            Ngày bảo trì
                        </div>
                        <div class="fw-semibold">
                            @(Model.NgayBaoTri.HasValue
                                ? Model.NgayBaoTri.Value.ToString("dd/MM/yyyy")
                                : "Chưa có lịch bảo trì")
                        </div>
                    </div>

                    <div>
                        <div class="text-muted small mb-2">
                            Ghi chú bảo trì
                        </div>

                        <div class="p-3 rounded-3 bg-light"
                             style="white-space: pre-line">
                            @(string.IsNullOrWhiteSpace(Model.GhiChuBaoTri)
                                ? "Không có ghi chú bảo trì"
                                : Model.GhiChuBaoTri)
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thao tác -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h6 class="fw-semibold mb-3">Thao tác</h6>

                    @if (laQuanLy)
                    {
                        <a asp-action="Edit"
                           asp-route-id="@Model.MaPhong"
                           class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-pencil-square me-1"></i>
                            Chỉnh sửa thông tin phòng
                        </a>
                    }

                    <a asp-action="@(laQuanLy ? "Index" : "TimKiem")"
                       class="btn btn-outline-secondary w-100">
                        <i class="bi bi-list-ul me-1"></i>
                        Danh sách phòng
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>