@model IEnumerable<QuanLy_15_UNETI15_TI17A4HN.Models.Phong>

@{
    ViewData["Title"] = "Tìm phòng";
    int trangHienTai = (int)ViewBag.TrangHienTai;
    int tongSoTrang = (int)ViewBag.TongSoTrang;
    int tongSoPhong = (int)ViewBag.TongSoPhong;
    var vaiTro = Context.Session.GetString("VaiTro");
    bool laQuanLy = vaiTro == "Admin" || vaiTro == "NhanVien";
}

<form asp-controller="Phong" asp-action="TimKiem" method="get">
    <div class="search-bar">
        <div class="sb-field">
            <label class="sb-label" for="tk-tukhoa">Từ khóa</label>
            <input id="tk-tukhoa" type="text" name="tuKhoa" value="@Context.Request.Query["tuKhoa"]"
                   class="form-control" placeholder="Số phòng hoặc tên loại phòng" />
        </div>
        <div class="sb-field">
            <label class="sb-label" for="tk-loai">Loại phòng</label>
            <select id="tk-loai" name="maLoaiPhong" class="form-select" asp-items="ViewBag.LoaiPhongs">
                <option value="all">Tất cả loại phòng</option>
            </select>
        </div>
        <div class="sb-field">
            <label class="sb-label" for="tk-nhan">Ngày nhận phòng</label>
            <input id="tk-nhan" type="date" name="ngayNhan" value="@Context.Request.Query["ngayNhan"]" class="form-control" />
        </div>
        <div class="sb-field">
            <label class="sb-label" for="tk-tra">Ngày trả phòng</label>
            <input id="tk-tra" type="date" name="ngayTra" value="@Context.Request.Query["ngayTra"]"
                   min="@Context.Request.Query["ngayNhan"]" class="form-control" />
        </div>
        <div class="sb-action">
            <button type="submit" class="btn btn-search">Tìm kiếm</button>
        </div>
    </div>

    <div class="filter-bar">
        <div class="filter-item">
            <label class="form-label" for="tk-tang">Tầng</label>
            <select id="tk-tang" name="tang" class="form-select">
                <option value="">Tất cả tầng</option>
                @for (int i = 1; i <= 10; i++)
                {
                    <option value="@i" selected="@(Context.Request.Query["tang"] == i.ToString())">Tầng @i</option>
                }
            </select>
        </div>
        <div class="filter-item">
            <label class="form-label" for="tk-trangthai">Trạng thái</label>
            <select id="tk-trangthai" name="trangThai" class="form-select">
                <option value="all">Tất cả trạng thái</option>
                <option value="TrongRanh" selected="@(Context.Request.Query["trangThai"] == "TrongRanh")">Còn trống</option>
                <option value="DaDat" selected="@(Context.Request.Query["trangThai"] == "DaDat")">Đã đặt</option>
                <option value="DangSuDung" selected="@(Context.Request.Query["trangThai"] == "DangSuDung")">Đang sử dụng</option>
                <option value="BaoTri" selected="@(Context.Request.Query["trangThai"] == "BaoTri")">Bảo trì</option>
                <option value="KhongKinhDoanh" selected="@(Context.Request.Query["trangThai"] == "KhongKinhDoanh")">Ngừng kinh doanh</option>
            </select>
        </div>
        <div class="filter-item">
            <label class="form-label" for="tk-giatu">Giá từ (đ)</label>
            <input id="tk-giatu" type="number" name="giaTu" min="0" value="@Context.Request.Query["giaTu"]" class="form-control" placeholder="Thấp nhất" />
        </div>
        <div class="filter-item">
            <label class="form-label" for="tk-giaden">Giá đến (đ)</label>
            <input id="tk-giaden" type="number" name="giaDen" min="0" value="@Context.Request.Query["giaDen"]" class="form-control" placeholder="Cao nhất" />
        </div>
        <div class="filter-item">
            <label class="form-label" for="tk-sapxep">Sắp xếp theo</label>
            <select id="tk-sapxep" name="sapXep" class="form-select">
                <option value="soPhongTang" selected="@(Context.Request.Query["sapXep"] == "soPhongTang")">Số phòng: tăng dần</option>
                <option value="soPhongGiam" selected="@(Context.Request.Query["sapXep"] == "soPhongGiam")">Số phòng: giảm dần</option>
                <option value="donGiaTang" selected="@(Context.Request.Query["sapXep"] == "donGiaTang")">Đơn giá: thấp đến cao</option>
                <option value="donGiaGiam" selected="@(Context.Request.Query["sapXep"] == "donGiaGiam")">Đơn giá: cao xuống thấp</option>
                <option value="tangTang" selected="@(Context.Request.Query["sapXep"] == "tangTang")">Tầng: thấp đến cao</option>
                <option value="tangGiam" selected="@(Context.Request.Query["sapXep"] == "tangGiam")">Tầng: cao xuống thấp</option>
                <option value="tenLoaiTang" selected="@(Context.Request.Query["sapXep"] == "tenLoaiTang")">Tên loại phòng: A → Z</option>
            </select>
        </div>
        <div class="filter-item">
            <a asp-controller="Phong" asp-action="TimKiem" class="btn btn-outline-secondary">Xóa bộ lọc</a>
        </div>
    </div>
</form>

<div asp-validation-summary="ModelOnly" class="alert alert-danger mt-3"></div>

<div class="page-head mt-4">
    <div>
        <h1>Chọn phòng</h1>
        <div class="result-count">Tìm thấy <strong>@tongSoPhong</strong> phòng &middot; Trang @trangHienTai / @tongSoTrang</div>
    </div>
    @if (laQuanLy)
    {
        <a asp-controller="Phong" asp-action="Create" class="btn btn-primary">+ Thêm phòng</a>
    }
</div>

@if (Model != null && Model.Any())
{
    <div class="room-list">
        @foreach (var item in Model)
        {
            <partial name="_PhongCard" model="item" />
        }
    </div>
}
else
{
    <div class="empty-state">Không tìm thấy phòng phù hợp. Hãy thử nới rộng bộ lọc.</div>
}

<nav aria-label="Phân trang" class="mt-4 d-flex justify-content-center">
    <ul class="pagination mb-0">
        <li class="page-item @(trangHienTai == 1 ? "disabled" : "")">
            <a class="page-link"
               asp-action="TimKiem"
               asp-route-tuKhoa="@ViewBag.TuKhoa"
               asp-route-maLoaiPhong="@ViewBag.MaLoaiPhong"
               asp-route-tang="@ViewBag.Tang"
               asp-route-trangThai="@ViewBag.TrangThai"
               asp-route-giaTu="@ViewBag.GiaTu"
               asp-route-giaDen="@ViewBag.GiaDen"
               asp-route-ngayNhan="@ViewBag.NgayNhan"
               asp-route-ngayTra="@ViewBag.NgayTra"
               asp-route-sapXep="@ViewBag.SapXep"
               asp-route-trang="@(trangHienTai - 1)">Trước</a>
        </li>

        @for (int i = 1; i <= tongSoTrang; i++)
        {
            <li class="page-item @(i == trangHienTai ? "active" : "")">
                <a class="page-link"
                   asp-action="TimKiem"
                   asp-route-tuKhoa="@ViewBag.TuKhoa"
                   asp-route-maLoaiPhong="@ViewBag.MaLoaiPhong"
                   asp-route-tang="@ViewBag.Tang"
                   asp-route-trangThai="@ViewBag.TrangThai"
                   asp-route-giaTu="@ViewBag.GiaTu"
                   asp-route-giaDen="@ViewBag.GiaDen"
                   asp-route-ngayNhan="@ViewBag.NgayNhan"
                   asp-route-ngayTra="@ViewBag.NgayTra"
                   asp-route-sapXep="@ViewBag.SapXep"
                   asp-route-trang="@i">@i</a>
            </li>
        }

        <li class="page-item @(trangHienTai == tongSoTrang ? "disabled" : "")">
            <a class="page-link"
               asp-action="TimKiem"
               asp-route-tuKhoa="@ViewBag.TuKhoa"
               asp-route-maLoaiPhong="@ViewBag.MaLoaiPhong"
               asp-route-tang="@ViewBag.Tang"
               asp-route-trangThai="@ViewBag.TrangThai"
               asp-route-giaTu="@ViewBag.GiaTu"
               asp-route-giaDen="@ViewBag.GiaDen"
               asp-route-ngayNhan="@ViewBag.NgayNhan"
               asp-route-ngayTra="@ViewBag.NgayTra"
               asp-route-sapXep="@ViewBag.SapXep"
               asp-route-trang="@(trangHienTai + 1)">Sau</a>
        </li>
    </ul>
</nav>
