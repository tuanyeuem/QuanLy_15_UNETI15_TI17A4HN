@* Họ và tên: Lê Văn Thanh
   Mã sinh viên: 23103100200
   Nội dung thực hiện: Khung giao diện dùng chung và menu quản trị.
   Họ và tên: Nguyễn Đình Quang
   Mã sinh viên: 23103100259
   Nội dung thực hiện: Hợp nhất layout và điều hướng đến chức năng khách hàng Module 3. *@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý khách sạn</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLy_15_UNETI15_TI17A4HN.styles.css" asp-append-version="true" />
</head>
<body>
    @{ var vaiTro = Context.Session.GetString("VaiTro"); var hoTen = Context.Session.GetString("HoTen"); }
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Quản lý khách sạn</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNav" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        @if (vaiTro is "Admin" or "NhanVien")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="DatPhong" asp-action="Index">Đặt phòng</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="QuanLyKhachHang" asp-action="Index">Quản lý khách hàng</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="ChiTietDatPhong" asp-action="Index">Chi tiết lưu trú</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="ThongKe" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="ThongKe" asp-action="Index">Thống kê</a></li>
                        }
                        @if (vaiTro == "KhachHang")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="KhachHang" asp-action="HoSo">Hồ sơ cá nhân</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="KhachHang" asp-action="DatPhong">Đặt phòng</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="KhachHang" asp-action="TheoDoi">Theo dõi đặt phòng</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="ChiTietDatPhong" asp-action="KetQuaCuaToi">Kết quả đặt phòng</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (vaiTro == null)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><span class="nav-link">Xin chào, @hoTen (@vaiTro)</span></li>
                            <li class="nav-item">
                                <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post">
                                    <button type="submit" class="btn btn-link nav-link">Đăng xuất</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="container pb-4" role="main">
        @RenderBody()
    </main>
    <footer class="border-top footer text-muted py-3">
        <div class="container">&copy; 2026 - Quản lý đặt phòng khách sạn</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
