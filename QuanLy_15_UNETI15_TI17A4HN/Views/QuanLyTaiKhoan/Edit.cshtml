@model QuanLy_15_UNETI15_TI17A4HN.ViewModels.TaiKhoanSuaViewModel
@{ViewData["Title"]="Sửa tài khoản";}
<h1>Sửa tài khoản @Model.TenDangNhap</h1><form asp-action="Edit" asp-route-id="@Model.MaTaiKhoan" method="post" class="col-md-7"><input asp-for="MaTaiKhoan" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="TenDangNhap" class="form-label"></label><input asp-for="TenDangNhap" class="form-control" readonly/></div><div class="mb-3"><label asp-for="HoTen" class="form-label"></label><input asp-for="HoTen" class="form-control"/><span asp-validation-for="HoTen" class="text-danger"></span></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger"></span></div>
@if(ViewData["LaChinhMinh"] as bool? != true){<div class="mb-3"><label asp-for="VaiTro" class="form-label"></label><select asp-for="VaiTro" class="form-select"><option value="Admin">Admin</option><option value="NhanVien">Nhân viên</option><option value="KhachHang">Khách hàng</option></select><span asp-validation-for="VaiTro" class="text-danger"></span></div><div class="form-check mb-3"><input asp-for="TrangThai" class="form-check-input"/><label asp-for="TrangThai" class="form-check-label"></label></div>}else{<input asp-for="VaiTro" type="hidden"/><input asp-for="TrangThai" type="hidden"/><div class="alert alert-info">Bạn không thể tự đổi vai trò hoặc khóa tài khoản đang đăng nhập.</div>}
<button class="btn btn-primary">Lưu thay đổi</button> <a asp-action="Index" class="btn btn-secondary">Quay lại</a></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}