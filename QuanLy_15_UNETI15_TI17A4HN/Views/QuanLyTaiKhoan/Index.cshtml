@* Họ tên: Nguyễn Đình Tuấn | MSSV: 23103100235 | Nội dung: Quản trị tài khoản. *@
@model IEnumerable<QuanLy_15_UNETI15_TI17A4HN.Models.TaiKhoan>
@{ViewData["Title"]="Quản lý tài khoản";}
<div class="d-flex justify-content-between mb-3"><h1>Quản lý tài khoản</h1><a asp-action="Create" class="btn btn-primary">Thêm tài khoản</a></div>
@if(TempData["ThongBao"] is string ok){<div class="alert alert-success">@ok</div>} @if(TempData["Loi"] is string err){<div class="alert alert-danger">@err</div>}
<form method="get" class="row g-2 mb-3"><div class="col-md-5"><input name="tuKhoa" value="@ViewData["TuKhoa"]" class="form-control" placeholder="Tìm tên đăng nhập, họ tên, email"/></div><div class="col-md-3"><select name="vaiTro" class="form-select"><option value="">Tất cả vai trò</option><option value="Admin" selected="@(ViewData["VaiTro"] as string=="Admin")">Admin</option><option value="NhanVien" selected="@(ViewData["VaiTro"] as string=="NhanVien")">Nhân viên</option><option value="KhachHang" selected="@(ViewData["VaiTro"] as string=="KhachHang")">Khách hàng</option></select></div><div class="col-md-2"><select name="trangThai" class="form-select"><option value="">Mọi trạng thái</option><option value="hoatdong" selected="@(ViewData["TrangThai"] as string=="hoatdong")">Hoạt động</option><option value="khoa" selected="@(ViewData["TrangThai"] as string=="khoa")">Đã khóa</option></select></div><div class="col-md-2"><button class="btn btn-outline-primary">Lọc</button></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Tên đăng nhập</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.TenDangNhap</td><td>@x.HoTen</td><td>@x.Email</td><td>@(x.VaiTro=="NhanVien"?"Nhân viên":x.VaiTro=="KhachHang"?"Khách hàng":x.VaiTro)</td><td><span class="badge @(x.TrangThai?"bg-success":"bg-secondary")">@(x.TrangThai?"Hoạt động":"Đã khóa")</span></td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@x.MaTaiKhoan" class="btn btn-sm btn-outline-primary">Sửa</a> <a asp-action="DatLaiMatKhau" asp-route-id="@x.MaTaiKhoan" class="btn btn-sm btn-outline-warning">Đặt lại mật khẩu</a>@if(x.MaTaiKhoan!=(int?)ViewData["MaDangDangNhap"]){<form asp-action="DoiTrangThai" asp-route-id="@x.MaTaiKhoan" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger">@(x.TrangThai?"Khóa":"Mở khóa")</button></form>}</td></tr>}
</tbody></table></div>